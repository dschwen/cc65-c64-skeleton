/* Room 00 - see rooms/00.c for the tile hooks that call these entries by
 * key (STORY_ROOM00_* in src/story.h). */
room 00 {
    entry STORY_ROOM00_LOOK_TREE {
        text "The tree has a knot hole."
    }
    entry STORY_ROOM00_USE_TREE {
        text "You knock on the tree, but nothing happens."
    }
    entry STORY_ROOM00_LOOK_MILESTONE {
        text "A weathered stone marker, etched with an arrow and the words: 20 miles to nowhere in particular."
        set_flag STORY_STATE_ROOM_00_MILESTONE_SEEN 1
    }
    entry STORY_ROOM00_MYSTERY_SEQUENCE {
        lightning
        lightning
        lightning
        room_transition_here 1
    }
}
