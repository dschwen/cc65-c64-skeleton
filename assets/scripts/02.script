/* Room 02 - the inn's tavern common room. See rooms/02.rc for the
 * dispatch and STORY_ROOM02_* in src/story.h for these keys.
 *
 * The two open doorways in the top wall transition the instant the player
 * steps onto them: (2,0), behind the bar, into the kitchen (room 03);
 * (15,0), beside the hearth, into the guest corridor (room 05).
 *
 * TALK_ORRA/TALK_VEY/TALK_CALDUS each have a one-time scripted first
 * meeting (gated on their STORY_STATE_ROOM_02_MET_* flag) followed by
 * `converse` into their "Ask about" conversation - conversations/20
 * (Orra), 21 (Vey), 22 (Caldus); those IDs are only a readability
 * convention, conversation IDs are their own space. Portraits: 0 Sir
 * Caldus (visor closed), 1 Orra, 2 Vey, 3 Mara, 4 Pell, 5 Caldus with
 * his visor freed (assets/portraits; 03-05 are drawn by
 * tools/draw_portraits.py).
 *
 * Caldus's Lamp Oil payoff and Orra's Invite payoff are resolved by
 * mentioning the trigger word ("oil" / "letter") in conversation - see
 * those conversation scripts' topics. Using the item at the NPC only gives
 * a redirect hint (the check_item branches below). Freeing Caldus hands
 * over the Silver Shard; resolving Orra hands over the Moon Brooch
 * (MOONFEN_STORY_DESIGN.md section 5); the third token, the Brass Key, is
 * Pell's (05.script / conversations/05). Orra's Blank Letter is revealed
 * into the Orra Invite at the kitchen kettle (03.script).
 *
 * The hearth (12,1) lights the Long Taper into a Lit Taper - the item's
 * own type is the persistent "is it lit" state, and a carried item's light
 * byte lights the player (src/hero_light.c) - and, with nothing to light,
 * yields a scoop of Hearth Ash. The finale (section 10) uses the dining
 * table (15,4) and the service bell (2,3). */
room 02 {
    entry STORY_ROOM02_LEAVE_INN {
        room_transition 1 21 5
    }
    entry STORY_ROOM02_LOOK_ORRA {
        text "A woman in a dark velvet cloak sits alone in the corner, watching the room over the rim of her cup."
    }
    entry STORY_ROOM02_TALK_ORRA {
        portrait_show 1 right
        check_flag STORY_STATE_ROOM_02_MET_ORRA == 0 {
            text "She studies you for a long moment before you can speak."
            wait_key
            text "\"So. The one they say robbed Master Vey,\" she says quietly. \"I don't believe that of you.\""
            wait_key
            text "\"Whether anyone else shares my opinion... we shall see, won't we.\""
            wait_key
            text "She produces a water-stained letter, the ink run to smears. \"For what it's worth - I can't make sense of this either. Perhaps you'll have better luck.\""
            give_object OBJ_BLANK_LETTER 1
            set_flag STORY_STATE_ROOM_02_MET_ORRA 1
        } else {
            check_flag STORY_STATE_ROOM_02_ORRA_HELPED == 0 {
                check_item OBJ_ORRA_INVITE {
                    text "Lady Orra glances at the letter in your hand, but says nothing. Perhaps you should simply tell her what it says."
                } else {
                    text "\"Still proving them wrong, I hope,\" Lady Orra says, and returns to watching the room."
                }
            } else {
                text "\"Still proving them wrong, I hope,\" Lady Orra says, and returns to watching the room."
            }
        }
        /* No wait_key/portrait_hide here - converse defers to
         * script_banked_run() (modules/script.c), which already waits for
         * a fresh key before handing over whenever this entry's own text
         * left something on screen. */
        converse 20
    }
    entry STORY_ROOM02_LOOK_VEY {
        text "The innkeeper wipes down the bar, glancing up at every creak of the door."
    }
    entry STORY_ROOM02_TALK_VEY {
        portrait_show 2 left
        check_flag STORY_STATE_ROOM_02_MET_VEY == 0 {
            text "The innkeeper looks up as you shake the rain from your coat."
            wait_key
            text "\"Moonfen Inn welcomes all travelers,\" he says, \"though I'll admit we're a strange house to land in tonight.\""
            wait_key
            text "\"There's been trouble here - a guest robbed, and no one but you come through that door since. You understand why folk might look at the last stranger first.\""
            wait_key
            text "\"Prove me wrong and you're welcome at my fire. That's all I ask.\""
            set_flag STORY_STATE_ROOM_02_MET_VEY 1
        } else {
            text "\"Still finding your feet, traveler?\" Vey says. \"The offer stands.\""
        }
        converse 21
    }
    entry STORY_ROOM02_LOOK_CALDUS {
        check_flag STORY_STATE_ROOM_02_CALDUS_FREED == 0 {
            portrait_show 0 right
            text "A knight in dented plate sits stiffly by the hearth, his visor jammed half-shut."
        } else {
            portrait_show 5 right
            text "Sir Caldus, visor up at last: a weathered face and a drooping moustache."
        }
        wait_key
        portrait_hide
    }
    entry STORY_ROOM02_TALK_CALDUS {
        check_flag STORY_STATE_ROOM_02_CALDUS_FREED == 0 {
            portrait_show 0 right
        } else {
            portrait_show 5 right
        }
        check_flag STORY_STATE_ROOM_02_MET_CALDUS == 0 {
            text "The knight straightens as best he can, one hand still braced against his helm."
            wait_key
            text "\"Sir Caldus, formerly of the Silver Tower,\" he says, muffled by the visor. \"This cursed hinge seized somewhere between the storm and the door, and I've yet to find a soul who can loosen it.\""
            wait_key
            text "\"If you should come across oil - lamp oil, axle grease, anything - I'd count it a great kindness.\""
            set_flag STORY_STATE_ROOM_02_MET_CALDUS 1
        } else {
            check_flag STORY_STATE_ROOM_02_CALDUS_FREED == 0 {
                check_item OBJ_LAMP_OIL {
                    text "Sir Caldus eyes the vial in your hand, but doesn't reach for it. \"Tell me plainly what you've brought, rather than waving it at me.\""
                } else {
                    text "\"Still rusted shut, I'm afraid,\" Caldus says, giving his visor a hopeful tap."
                }
            } else {
                text "\"It swings like a gate now,\" Caldus says, lifting the visor and letting it fall again, just for the pleasure of it."
            }
        }
        converse 22
    }
    entry STORY_ROOM02_ENTER_KITCHEN {
        room_transition 3 12 18
    }
    entry STORY_ROOM02_USE_HEARTH {
        check_item OBJ_LONG_TAPER {
            take_item OBJ_LONG_TAPER
            give_object OBJ_LIT_TAPER 1
            sound SOUND_SIZZLE
            text "You touch the taper to the hearth's embers, and it catches, flame steady."
        } else {
            check_item OBJ_LIT_TAPER {
                text "The taper is already burning."
            } else {
                check_item OBJ_HEARTH_ASH {
                    text "The hearth's embers glow, but you have nothing to light."
                } else {
                    give_object OBJ_HEARTH_ASH 1
                    text "You scoop a handful of cool ash from the edge of the hearth."
                }
            }
        }
    }
    entry STORY_ROOM02_USE_TABLE {
        check_flag STORY_STATE_BROTH_SERVED == 1 {
            text "The broth is already set out, untouched and still warm."
        } else {
            check_item OBJ_GUESTS_BROTH {
                take_item OBJ_GUESTS_BROTH
                set_flag STORY_STATE_BROTH_SERVED 1
                text "You set the Guest's Broth on the dining table, as the recipe stone described. It smells, unaccountably, like moonlight."
            } else {
                text "An empty table. Whatever belongs here, you don't have it yet."
            }
        }
    }
    entry STORY_ROOM02_LOOK_BELL {
        text "A small brass bell on the end of the counter, worn smooth by years of ringing."
    }
    entry STORY_ROOM02_LOOK_TABLE {
        check_flag STORY_STATE_BROTH_SERVED == 0 {
            text "A dining table, set for a guest who hasn't arrived yet."
        } else {
            text "The Guest's Broth, set out and waiting."
        }
    }
    entry STORY_ROOM02_RING_BELL {
        check_flag STORY_STATE_FINALE_DONE == 0 {
            check_flag STORY_STATE_HOST_REVEALED == 0 {
                sound SOUND_BELL
                text "A small brass bell. Ringing it summons no one in particular."
            } else {
                check_flag STORY_STATE_BROTH_SERVED == 0 {
                    text "You reach for the bell, then stop. Something isn't finished yet - the broth, perhaps."
                } else {
                    sound SOUND_BELL
                    text "You ring the bell. It doesn't sound like brass - it sounds like something much older."
                    wait_key
                    text "Mara steps out from the kitchen doorway, as though she'd been standing just out of sight the whole time."
                    wait_key
                    portrait_show 2 left
                    text "Master Vey drops a mug. \"You - you can't be here - the cellar's been sealed since -\""
                    wait_key
                    text "\"Since I chose to sleep, Vey. Not since I stopped existing. You've been careless about the difference.\""
                    wait_key
                    text "\"I told them the truth of it,\" Vey stammers. \"A guest was robbed. Someone had to answer for it.\""
                    wait_key
                    text "\"No one was robbed. A traveler dropped a seal in the mud, and you built a trial out of your own fear of my cellar door.\""
                    portrait_hide
                    wait_key
                    portrait_show 3 left
                    text "She turns to you. \"You found what was actually lost, returned it to those who'd lost it, and asked nothing back. That is the law of this house - not Vey's. Mine.\""
                    wait_key
                    text "\"The broth is the guesting-rite, older than the inn itself. You've kept it. Every guest here is free to go - Vey included, free of pretending to an authority that was never really his.\""
                    portrait_hide
                    wait_key
                    text "Vey sags against the counter, more relieved than ashamed. Upstairs and down, you hear doors opening that have stayed shut all night."
                    wait_key
                    text "Moonfen Inn, whatever it truly is, has finally kept its own law - and let its guests go, you among them, accused of nothing at all."
                    set_flag STORY_STATE_FINALE_DONE 1
                    end_game
                }
            }
        } else {
            text "The inn is quiet now, the storm spent. Moonfen has kept its true law, at last."
        }
    }
    entry STORY_ROOM02_ENTER_CORRIDOR {
        room_transition 5 4 18
    }
}
