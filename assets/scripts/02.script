/* Room 02 - the inn's tavern common room. See rooms/02.rc for the door/
 * Lady Orra/Master Vey/Sir Caldus dispatch and STORY_ROOM02_* in
 * src/story.h for these keys.
 *
 * The two open doorways in the top wall transition the instant the player
 * steps onto them (rooms/asm/02_enter_tile.s) rather than requiring Use:
 * (2,0), behind the bar, into the kitchen (room 03); (15,0), beside the
 * hearth, into the guest corridor (room 05). The old side door at (19,6)
 * has been removed - STORY_ROOM02_ENTER_KITCHEN is reached only via (2,0)
 * now.
 *
 * STORY_ROOM02_TALK_ORRA/STORY_ROOM02_TALK_VEY/STORY_ROOM02_TALK_CALDUS
 * are one-time scripted first-meeting greetings, each gated on its own
 * STORY_STATE_ROOM_02_MET_* flag - the full topic-based "Ask about..."
 * conversation is a later pass. Portrait 0 is Sir Caldus (visor closed) -
 * shown on both Look and Use/Talk. Portrait IDs 1 (Orra) and 2 (Vey) are
 * still placeholder references: neither has art authored yet
 * (assets/portraits/01, /02 - the asset editor's Portrait mode), so
 * portrait_show renders a blank box there for now.
 *
 * Caldus's Lamp Oil payoff (STORY_ROOM02_CALDUS_FREE) and the hearth's Long
 * Taper lighting (STORY_ROOM02_LIGHT_TAPER/_ALREADY/_NO_ITEM) are dispatched
 * from a hand-written asm fallback (rooms/asm/02_use_at.s) rather than a
 * plain `at X,Y` entry in rooms/02.rc - the script DSL has no opcode to
 * check, consume, or add inventory contents, so the has-item/consume-item/
 * add-item logic lives in that fragment and calls into these entries by
 * key. Lamp Oil is object type 51, Long Taper is object type 52, and
 * lighting the taper swaps it in inventory for a Lit Taper (type 53, a
 * minimal light source, assets/objects.cobj) - the item's own type is the
 * persistent "is it lit" state rather than a separate flag. The Silver
 * Tower's payoff for freeing Caldus isn't implemented yet (no Silver Shard
 * item exists), so freeing him for now is a flag-only outcome. */
room 02 {
    entry STORY_ROOM02_LEAVE_INN {
        room_transition 1 21 5
    }
    entry STORY_ROOM02_LOOK_ORRA {
        text "A woman in a dark velvet cloak sits alone in the corner, watching the room over the rim of her cup."
    }
    entry STORY_ROOM02_TALK_ORRA {
        portrait_show 1 right
        check_flag STORY_STATE_ROOM_02_MET_ORRA == 0 {
            text "She studies you for a long moment before you can speak."
            wait_key
            text "\"So. The one they say robbed Master Vey,\" she says quietly. \"I don't believe that of you.\""
            wait_key
            text "\"Whether anyone else shares my opinion... we shall see, won't we.\""
            set_flag STORY_STATE_ROOM_02_MET_ORRA 1
        } else {
            text "\"Still proving them wrong, I hope,\" Lady Orra says, and returns to watching the room."
        }
        wait_key
        portrait_hide
    }
    entry STORY_ROOM02_LOOK_VEY {
        text "The innkeeper wipes down the bar, glancing up at every creak of the door."
    }
    entry STORY_ROOM02_TALK_VEY {
        portrait_show 2 left
        check_flag STORY_STATE_ROOM_02_MET_VEY == 0 {
            text "The innkeeper looks up as you shake the rain from your coat."
            wait_key
            text "\"Moonfen Inn welcomes all travelers,\" he says, \"though I'll admit we're a strange house to land in tonight.\""
            wait_key
            text "\"There's been trouble here - a guest robbed, and no one but you come through that door since. You understand why folk might look at the last stranger first.\""
            wait_key
            text "\"Prove me wrong and you're welcome at my fire. That's all I ask.\""
            set_flag STORY_STATE_ROOM_02_MET_VEY 1
        } else {
            text "\"Still finding your feet, traveler?\" Vey says. \"The offer stands.\""
        }
        wait_key
        portrait_hide
    }
    entry STORY_ROOM02_LOOK_CALDUS {
        portrait_show 0 right
        text "A knight in dented plate sits stiffly by the hearth, his visor jammed half-shut."
        wait_key
        portrait_hide
    }
    entry STORY_ROOM02_TALK_CALDUS {
        portrait_show 0 right
        check_flag STORY_STATE_ROOM_02_MET_CALDUS == 0 {
            text "The knight straightens as best he can, one hand still braced against his helm."
            wait_key
            text "\"Sir Caldus, formerly of the Silver Tower,\" he says, muffled by the visor. \"This cursed hinge seized somewhere between the storm and the door, and I've yet to find a soul who can loosen it.\""
            wait_key
            text "\"If you should come across oil - lamp oil, axle grease, anything - I'd count it a great kindness.\""
            set_flag STORY_STATE_ROOM_02_MET_CALDUS 1
        } else {
            text "\"Still rusted shut, I'm afraid,\" Caldus says, giving his visor a hopeful tap."
        }
        wait_key
        portrait_hide
    }
    entry STORY_ROOM02_ENTER_KITCHEN {
        room_transition 3 12 18
    }
    entry STORY_ROOM02_CALDUS_FREE {
        portrait_show 0 right
        check_flag STORY_STATE_ROOM_02_CALDUS_FREED == 0 {
            text "You press the vial of lamp oil into the seized hinge and work the visor back and forth."
            wait_key
            text "With a screech of metal it finally gives, and Sir Caldus draws a first unmuffled breath."
            wait_key
            text "\"You have my thanks - truly,\" he says. \"If you ever need a blade at your back, ask.\""
            set_flag STORY_STATE_ROOM_02_CALDUS_FREED 1
        } else {
            text "\"Still breathing easy, thanks to you,\" Caldus says, tapping his now-loose visor."
        }
        wait_key
        portrait_hide
    }
    entry STORY_ROOM02_LIGHT_TAPER {
        text "You touch the taper to the hearth's embers, and it catches, flame steady."
    }
    entry STORY_ROOM02_LIGHT_TAPER_ALREADY {
        text "The taper is already burning."
    }
    entry STORY_ROOM02_LIGHT_TAPER_NO_ITEM {
        text "The hearth's embers glow, but you have nothing to light."
    }
    entry STORY_ROOM02_ENTER_CORRIDOR {
        room_transition 5 4 18
    }
}
