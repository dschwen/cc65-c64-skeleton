/* Room 03 - the inn's kitchen and pantry (MOONFEN_STORY_DESIGN.md section
 * 6). See rooms/03.rc for the door/stairs dispatch and STORY_ROOM03_* in
 * src/story.h for these keys.
 *
 * The stairway down to the basement is at (10,1), an already-walkable
 * tile (10) among the pantry shelving - stepping onto it transitions
 * immediately (rooms/asm/03_enter_tile.s) rather than requiring Use. The
 * player arrives from the tavern at (6,9); the real door back is one tile
 * south at (6,10) (the walkable door tile 5 in the south wall), which
 * transitions the same way - stepping onto it, not Using it.
 *
 * Lamp Oil (object type 51, tile 5,1) and Long Taper (object type 52, tile
 * 14,1) are takeable pickups - Take is a generic engine command (see
 * game_take_tile()), so placing them in assets/03 is all the wiring they
 * need to be picked up; STORY_ROOM02_CALDUS_FREE/STORY_ROOM02_LIGHT_TAPER
 * (rooms/asm/02_use_at.s) are where they pay off.
 *
 * The Cauldron (object type 39, tile 10,6) is the user's own addition; this
 * pass only gives it a look_at flavor line - the broth-recipe check
 * mechanic (MOONFEN_STORY_DESIGN.md section 6) is a follow-up pass.
 *
 * Tile 65 is a storm window - wherever it appears in this room (currently
 * 9,0 and 3,5), looking at it always shows STORY_ROOM03_LOOK_WINDOW,
 * dispatched generically by rooms/asm/03_look_at.s rather than a per-tile
 * `at X,Y` entry. */
room 03 {
    entry STORY_ROOM03_LEAVE_KITCHEN {
        room_transition 2 36 12
    }
    entry STORY_ROOM03_DESCEND_STAIRS {
        room_transition 4 32 4
    }
    entry STORY_ROOM03_LOOK_STAIRS_DOWN {
        text "These stairs seem to lead down into a dark musty basement."
    }
    entry STORY_ROOM03_LOOK_SHELVES {
        text "Pantry shelves, mostly bare - whatever was kept here has long since been used or taken."
    }
    entry STORY_ROOM03_LOOK_CAULDRON {
        text "A heavy iron cauldron, cold and empty."
    }
    entry STORY_ROOM03_LOOK_OIL {
        text "A small vial of lamp oil."
    }
    entry STORY_ROOM03_LOOK_TAPER {
        text "A long wax taper, unlit."
    }
    entry STORY_ROOM03_LOOK_WINDOW {
        text "Through the window you see the rain pouring down outside."
    }
}
