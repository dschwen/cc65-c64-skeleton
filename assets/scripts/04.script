/* Room 04 - basement placeholder (MOONFEN_STORY_DESIGN.md brass-key locked
 * door, tile 18,4 - not wired yet, no Brass Key item exists). See
 * rooms/04.rc for the stairs-up dispatch and STORY_ROOM04_* in src/story.h
 * for these keys.
 *
 * The stairs back up to the kitchen (room 03, tile 3,5) land at (4,5) here
 * - no stair art is drawn on this side yet, but the tile is walkable and
 * adjacent to the use_at trigger the same way room 03's side is. */
room 04 {
    entry STORY_ROOM04_ASCEND_STAIRS {
        room_transition 3 8 10
    }
    entry STORY_ROOM04_LOOK_STAIRS_UP {
        text "Stone steps lead back up to the kitchen."
    }
}
