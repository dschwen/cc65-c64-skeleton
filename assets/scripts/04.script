/* Room 04 - Moonlit Cellar (MOONFEN_STORY_DESIGN.md section 8). See
 * rooms/04.rc for the dispatch and STORY_ROOM04_* in src/story.h for
 * these keys.
 *
 * The stairs up to the kitchen are at (16,1), an already-walkable tile in
 * the entry alcove; stepping onto it transitions immediately.
 *
 * The alcove is separated from the rest of the cellar by a partition
 * wall; its only opening is the locked door at (18,4), tile
 * STORY_TILE_DOOR_LOCKED until opened. Using the Brass Key (from Pell)
 * swaps the tile to STORY_TILE_DOOR_OPEN, the walkable open-door tile
 * rooms 03 and 05 use, and sets STORY_STATE_BASEMENT_DOOR_OPEN. The tile
 * grid is reloaded from ROM on every room entry and is not part of the
 * world-state journal, so ENTER_ROOM re-applies the swap from the flag.
 *
 * The two braziers (OBJ_BRAZIER, tiles 11,3 and 13,3) ignite from a Lit
 * Taper into OBJ_LIT_BRAZIER (already-authored art and light) -
 * replace_object acts on the brazier at the tile the Use cursor chose.
 *
 * The cracked moon mirror sits at tiles (12,1)/(12,2). Repairing it needs
 * the Silver Shard (from Sir Caldus) *and* the Moon Brooch worn
 * (STORY_STATE_MOON_BROOCH_WORN, toggled from the inventory screen - see
 * story/story.c). Repairing recolors the mirror's two tile definitions
 * (tile_color; re-applied by ENTER_ROOM, since the shared tile table is
 * reloaded after every save/load) and adds Mara Moonfen beside it at
 * half-tile (26,2). Mara's reveal (TALK_MARA) sets MARA_REVEALED and
 * HOST_REVEALED; the finale (02.script) gates on the latter. The Recipe
 * Stone (5,8) only gives its real text once Mara has been revealed. */
room 04 {
    entry STORY_ROOM04_ENTER_ROOM {
        check_flag STORY_STATE_MIRROR_REPAIRED == 1 {
            tile_color STORY_TILE_MIRROR_FRAME STORY_COLOR_MIRROR_LIT
            tile_color STORY_TILE_MIRROR_GLASS STORY_COLOR_MIRROR_LIT
        }
        check_flag STORY_STATE_BASEMENT_DOOR_OPEN == 1 {
            set_tile 18 4 STORY_TILE_DOOR_OPEN
        }
    }
    entry STORY_ROOM04_ASCEND_STAIRS {
        room_transition 3 20 4
    }
    entry STORY_ROOM04_LOOK_STAIRS_UP {
        text "The stairs lead up to the kitchen."
    }
    entry STORY_ROOM04_USE_BRAZIER {
        check_object OBJ_BRAZIER {
            check_item OBJ_LIT_TAPER {
                replace_object OBJ_BRAZIER OBJ_LIT_BRAZIER
                sound SOUND_SIZZLE
                text "You touch the taper's flame to the brazier, and it catches."
            } else {
                text "The brazier is cold. You have nothing to light it with."
            }
        } else {
            text "The brazier is already burning."
        }
    }
    entry STORY_ROOM04_LOOK_MIRROR {
        check_flag STORY_STATE_MIRROR_REPAIRED == 0 {
            text "A tall mirror, its silvered glass split by a deep crack. Moonlight seems to pool behind the crack rather than reflect off it."
        } else {
            text "The mirror shines whole and bright now, more moonlight than glass - and it holds no reflection of the room at all."
        }
    }
    entry STORY_ROOM04_USE_MIRROR {
        check_flag STORY_STATE_MIRROR_REPAIRED == 1 {
            text "The mirror is whole. There is nothing left to repair."
        } else {
            check_item OBJ_SILVER_SHARD {
                check_flag STORY_STATE_MOON_BROOCH_WORN == 0 {
                    text "The shard fits the crack, but nothing happens. Some part of this feels unfinished - as if the mirror is waiting on you, not the other way around."
                } else {
                    take_item OBJ_SILVER_SHARD
                    set_flag STORY_STATE_MIRROR_REPAIRED 1
                    tile_color STORY_TILE_MIRROR_FRAME STORY_COLOR_MIRROR_LIT
                    tile_color STORY_TILE_MIRROR_GLASS STORY_COLOR_MIRROR_LIT
                    add_object OBJ_MARA_MOONFEN 26 2
                    sound SOUND_CHIME
                    text "You fit the silver shard into the crack. It seats with a faint chime, and the whole mirror flares silver-white."
                    wait_key
                    text "When your eyes adjust, the glass is whole - and someone is standing beside it who was not there a moment ago."
                }
            } else {
                text "The crack runs deep. Whatever fits it, you don't have it."
            }
        }
    }
    entry STORY_ROOM04_LOOK_DOOR {
        check_flag STORY_STATE_BASEMENT_DOOR_OPEN == 0 {
            text "A door of old, dark wood, bound in iron. The lock looks like it wants a plain brass key."
        } else {
            text "The door stands open, its lock long since given up."
        }
    }
    entry STORY_ROOM04_USE_DOOR {
        check_flag STORY_STATE_BASEMENT_DOOR_OPEN == 1 {
            text "The door stands open."
        } else {
            check_item OBJ_BRASS_KEY {
                set_tile 18 4 STORY_TILE_DOOR_OPEN
                set_flag STORY_STATE_BASEMENT_DOOR_OPEN 1
                sound SOUND_CLICK
                sound SOUND_CREAK
                text "The brass key turns easily, as though it were always meant for this lock. The door swings open onto the cellar beyond."
            } else {
                sound SOUND_THUD
                text "The door is locked. It wants a key."
            }
        }
    }
    entry STORY_ROOM04_LOOK_MARA {
        check_flag STORY_STATE_MIRROR_REPAIRED == 0 {
            text "You see nothing there but bare stone."
        } else {
            text "A woman who seems made as much of moonlight as of substance, watching you with patient, ancient eyes."
        }
    }
    entry STORY_ROOM04_TALK_MARA {
        check_flag STORY_STATE_MIRROR_REPAIRED == 0 {
            /* Mara only stands here once the mirror is repaired. */
            text "Nothing happens."
        } else {
            portrait_show 3 left
            check_flag STORY_STATE_MARA_REVEALED == 0 {
                text "\"You've done well to reach me,\" she says. \"I am Mara. This inn has been mine far longer than it has been Vey's.\""
                wait_key
                text "\"He tells guests they cannot leave until the matter of a robbery is settled. There was no robbery. There is only the old law: a guest may not leave unwelcomed by the house.\""
                wait_key
                text "\"I am the house. Vey only pours the ale.\""
                wait_key
                text "\"Bring me a proper Guest's Broth, made as it always was, and I will welcome your fellow guests myself - and let you all go.\""
                wait_key
                text "\"The recipe is carved behind me still, if your memory needs the help mine no longer does.\""
                set_flag STORY_STATE_MARA_REVEALED 1
                set_flag STORY_STATE_HOST_REVEALED 1
            } else {
                text "\"The broth, when you're ready,\" Mara says. \"I'll be here. I'm always here.\""
            }
            wait_key
            portrait_hide
        }
    }
    entry STORY_ROOM04_LOOK_RECIPE_STONE {
        check_flag STORY_STATE_MARA_REVEALED == 0 {
            text "A flat stone set into the wall, carved with worn lettering you can't quite make out in this light."
        } else {
            text "The recipe stone, easier to read now: moonmint, rainwater, and a pinch of hearth ash, simmered together."
        }
    }
    entry STORY_ROOM04_LOOK_WITCHLIGHT {
        text "A small blue flame burns in an alcove, fed by nothing you can see."
    }
}
