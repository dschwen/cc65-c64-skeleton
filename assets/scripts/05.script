/* Room 05 - Guest Corridor (MOONFEN_STORY_DESIGN.md's "Room 03 - Guest
 * Corridor"; puzzle chain per PELL_THIMBLE_PUZZLE.md). See rooms/05.rc for
 * the door/NPC dispatch and STORY_ROOM05_* in src/story.h for these keys.
 *
 * The door back to the tavern (south wall, tile 2,10) transitions the
 * instant the player steps onto it (see rooms/asm/05_enter_tile.s),
 * matching room 02's own top doors - landing back at (15,1), just south of
 * the corridor doorway there.
 *
 * Of the three guest-room doors, (4,3) is Pell's blue-seal door, (9,10)
 * is Sir Caldus's silver-tower door, and (17,10) is Lady Orra's
 * pale-rose door. Look on all three gives special evidence text
 * (STORY_ROOM05_LOOK_BLUE_DOOR/_SILVER_DOOR/_ROSE_DOOR), setting
 * BLUE_DOOR_SEEN/SILVER_DOOR_SEEN/ROSE_DOOR_SEEN - independent
 * corroboration for each NPC's identity, not a mechanical gate on
 * anything (see MOONFEN_STORY_DESIGN.md's Branches B and C). Use stays
 * "Locked." on all three.
 *
 * Pell Thimble (object type 44, tile 4,7) is the user's own addition.
 * Using the Blue Seal at him directly no longer resolves anything -
 * rooms/c/05_use_at.c just gives a redirect hint
 * (STORY_ROOM05_PELL_SEAL_HINT) when the player carries it and isn't yet
 * helped, which itself leads straight into `converse 5` (same as
 * TALK_PELL) so the player can act on it immediately; STORY_ROOM05_
 * TALK_PELL otherwise (no seal, or already helped - the "thanks again"
 * repeat handles itself via check_flag). The Blue Seal check that used to
 * live in that asm fallback (has the seal? has he seen both pieces of
 * evidence?) is now entirely in story_topic_resolve()
 * (modules/script.c - not story/story.c, despite being story-specific
 * content; see that function's own comment for why): mentioning "seal"
 * while talking to him resolves it in C if both evidence flags are set
 * (consumes the seal, gives the Brass Key - object type 10 - and sets
 * PELL_HELPED), or gives the existing "not proof enough" refusal (seal
 * kept) if a clue is still missing. Same trigger-word pattern is used for
 * Caldus/oil and Orra/
 * letter in room 02 - see assets/scripts/02.script's header.
 *
 * TALK_PELL ends with `converse 5` (assets/scripts/conversations/05.script):
 * after Pell's scripted line for the visit, the player can ask him about
 * "name", "job", "seal", and whatever else his answers mention.
 *
 * The torn invitation (object type 3, tile 5,7, the user's own addition -
 * currently takeable, same as any other pickup) is the first piece of
 * evidence; the blue-seal door is the second. Either can be examined in
 * any order, before or after meeting Pell. Reading it (Look) is what sets
 * PELL_INVITE_SEEN, regardless of whether it's later picked up - it isn't
 * consumed or handed to Pell (unlike the Blue Seal), just a clue you learn.
 *
 * Tile 65 is the same storm window as room 03's (currently at 2,0 and
 * 19,8) - looking at it always shows STORY_ROOM05_LOOK_WINDOW, dispatched
 * generically by rooms/asm/05_look_at.s rather than a per-tile `at X,Y`
 * entry. */
room 05 {
    entry STORY_ROOM05_LEAVE_CORRIDOR {
        room_transition 2 30 2
    }
    entry STORY_ROOM05_LOOK_WINDOW {
        text "Through the window you see the rain pouring down outside."
    }
    entry STORY_ROOM05_USE_GUEST_DOOR {
        text "Locked."
    }
    entry STORY_ROOM05_LOOK_PELL {
        text "A courier in a travel-worn coat, keeping close to his mailbag."
    }
    entry STORY_ROOM05_LOOK_INVITATION {
        check_flag STORY_STATE_ROOM_05_MET_PELL == 0 {
            text "A torn invitation. Most of the writing has run into blue-grey smears."
            wait_key
            text "Only one line survives: \"The bearer of the blue...\""
        } else {
            text "Pell's damaged invitation. The lower corner has been torn away where a wax seal might once have been attached."
            wait_key
            text "Only one line remains legible: \"The bearer of the blue...\""
        }
        set_flag STORY_STATE_ROOM_05_PELL_INVITE_SEEN 1
    }
    entry STORY_ROOM05_LOOK_BLUE_DOOR {
        text "A guest-room door. A small brass plaque bears an unfamiliar symbol."
        wait_key
        text "Looking closer: the plaque shows a blue circle crossed by a silver thread, and a smear of blue sealing wax clings beside the latch."
        set_flag STORY_STATE_ROOM_05_BLUE_DOOR_SEEN 1
    }
    entry STORY_ROOM05_LOOK_SILVER_DOOR {
        text "Another guest-room door. Its plaque bears a tower worked in silver."
        wait_key
        text "The same sigil is etched into the knight's dented plate downstairs - this must have been Sir Caldus's room."
        set_flag STORY_STATE_ROOM_05_SILVER_DOOR_SEEN 1
    }
    entry STORY_ROOM05_LOOK_ROSE_DOOR {
        text "A third guest-room door. Its plaque is worked in the shape of a pale rose."
        wait_key
        text "The same pale rose is pinned to the collar of the woman downstairs who calls herself Lady Orra."
        set_flag STORY_STATE_ROOM_05_ROSE_DOOR_SEEN 1
    }
    entry STORY_ROOM05_TALK_PELL {
        portrait_show 4 left
        check_flag STORY_STATE_ROOM_05_PELL_HELPED == 0 {
            check_flag STORY_STATE_ROOM_05_MET_PELL == 0 {
                text "\"Thimble. Pell Thimble. Courier, ordinarily. Prisoner of hospitality, presently.\""
                wait_key
                text "\"Vey says none of us leave until the matter of the guests is settled. I'd be happier if I understood what that meant.\""
                wait_key
                text "\"My invitation was damaged in the storm. Without it, Vey claims he cannot prove which room was mine. Half the writing is gone - and the seal came off somewhere outside.\""
                set_flag STORY_STATE_ROOM_05_MET_PELL 1
            } else {
                text "\"Still no proof, if that's what you're asking,\" Pell says, glancing at his mailbag."
            }
        } else {
            text "\"Thanks again, for what it's worth,\" Pell says, patting his mailbag."
        }
        /* No wait_key here: converse defers to script_banked_run()
         * (modules/script.c), which already waits for a fresh key before
         * handing over whenever this entry's own text left something on
         * screen - an explicit wait_key here would demand a second,
         * redundant keypress before the "Ask about" prompt appears. */
        converse 5
    }
    entry STORY_ROOM05_PELL_SEAL_HINT {
        portrait_show 4 left
        text "Pell eyes the seal in your palm, but doesn't reach for it. \"You'll have to actually tell me about it.\""
        /* No wait_key/portrait_hide here - straight into conversation, same
         * as STORY_ROOM05_TALK_PELL, so the player can immediately mention
         * "seal" right where they were just told to. */
        converse 5
    }
}
