/* Room 05 - Guest Corridor (MOONFEN_STORY_DESIGN.md's "Guest Corridor";
 * puzzle chain per PELL_THIMBLE_PUZZLE.md). See rooms/05.rc for the
 * dispatch and STORY_ROOM05_* in src/story.h for these keys.
 *
 * The door back to the tavern (south wall, tile 2,10) transitions the
 * instant the player steps onto it, landing back at (15,1) just south of
 * the corridor doorway there.
 *
 * Of the three guest-room doors, (4,3) is Pell's blue-seal door, (9,10)
 * is Sir Caldus's silver-tower door, and (17,10) is Lady Orra's
 * pale-rose door. Look on all three gives evidence text and sets
 * BLUE_DOOR_SEEN/SILVER_DOOR_SEEN/ROSE_DOOR_SEEN - independent
 * corroboration for each NPC's identity. Use stays "Locked." on all three.
 *
 * Pell Thimble (OBJ_PELL_THIMBLE, tile 4,7): the Blue Seal is handed over
 * by mentioning "seal" in his conversation (conversations/05.script),
 * which also checks that both pieces of evidence - the torn invitation
 * and the blue door - have been examined. Using the seal at him directly
 * only gives a redirect hint (the check_item branch below).
 *
 * The torn invitation (tile 5,7) is the first piece of evidence; the
 * blue-seal door is the second. Reading it (Look) sets PELL_INVITE_SEEN
 * whether or not it's later picked up; carrying it to Pell and asking about
 * "invitation" or "seal" sets it too (conversations/05.script), so taking
 * it unread can't strand the puzzle. Picking it up sets
 * ROOM_05_INVITATION_TAKEN through the engine's GAME_SCRIPT_TAKEN hook, so
 * looking at the spot afterwards no longer describes it lying there. */
room 05 {
    entry STORY_ROOM05_LEAVE_CORRIDOR {
        room_transition 2 30 2
    }
    entry STORY_ROOM05_LOOK_WINDOW {
        text "Through the window you see the rain pouring down outside."
    }
    entry STORY_ROOM05_USE_GUEST_DOOR {
        sound SOUND_THUD
        text "Locked."
    }
    entry STORY_ROOM05_LOOK_PELL {
        text "A courier in a travel-worn coat, keeping close to his mailbag."
    }
    entry GAME_SCRIPT_TAKEN {
        check_item OBJ_INVITATION {
            set_flag STORY_STATE_ROOM_05_INVITATION_TAKEN 1
        }
    }
    entry STORY_ROOM05_LOOK_INVITATION {
        check_flag STORY_STATE_ROOM_05_INVITATION_TAKEN == 1 {
            text "Worn floorboards. The torn invitation that lay here is in your pack now."
        } else {
            check_flag STORY_STATE_ROOM_05_MET_PELL == 0 {
                text "A torn invitation. Most of the writing has run into blue-grey smears."
                wait_key
                text "Only one line survives: \"The bearer of the blue...\""
            } else {
                text "Pell's damaged invitation. The lower corner has been torn away where a wax seal might once have been attached."
                wait_key
                text "Only one line remains legible: \"The bearer of the blue...\""
            }
            set_flag STORY_STATE_ROOM_05_PELL_INVITE_SEEN 1
        }
    }
    entry STORY_ROOM05_LOOK_BLUE_DOOR {
        text "A guest-room door. A small brass plaque bears an unfamiliar symbol."
        wait_key
        text "Looking closer: the plaque shows a blue circle crossed by a silver thread, and a smear of blue sealing wax clings beside the latch."
        set_flag STORY_STATE_ROOM_05_BLUE_DOOR_SEEN 1
    }
    entry STORY_ROOM05_LOOK_SILVER_DOOR {
        text "Another guest-room door. Its plaque bears a tower worked in silver."
        wait_key
        text "The same sigil is etched into the knight's dented plate downstairs - this must have been Sir Caldus's room."
        set_flag STORY_STATE_ROOM_05_SILVER_DOOR_SEEN 1
    }
    entry STORY_ROOM05_LOOK_ROSE_DOOR {
        text "A third guest-room door. Its plaque is worked in the shape of a pale rose."
        wait_key
        text "The same pale rose is pinned to the collar of the woman downstairs who calls herself Lady Orra."
        set_flag STORY_STATE_ROOM_05_ROSE_DOOR_SEEN 1
    }
    entry STORY_ROOM05_TALK_PELL {
        portrait_show 4 left
        check_flag STORY_STATE_ROOM_05_PELL_HELPED == 0 {
            check_flag STORY_STATE_ROOM_05_MET_PELL == 0 {
                text "\"Thimble. Pell Thimble. Courier, ordinarily. Prisoner of hospitality, presently.\""
                wait_key
                text "\"Vey says none of us leave until the matter of the guests is settled. I'd be happier if I understood what that meant.\""
                wait_key
                text "\"My invitation was damaged in the storm. Without it, Vey claims he cannot prove which room was mine. Half the writing is gone - and the seal came off somewhere outside.\""
                set_flag STORY_STATE_ROOM_05_MET_PELL 1
            } else {
                check_item OBJ_BLUE_SEAL {
                    text "Pell eyes the seal in your palm, but doesn't reach for it. \"You'll have to actually tell me about it.\""
                } else {
                    text "\"Still no proof, if that's what you're asking,\" Pell says, glancing at his mailbag."
                }
            }
        } else {
            text "\"Thanks again, for what it's worth,\" Pell says, patting his mailbag."
        }
        /* No wait_key here: converse defers to script_banked_run()
         * (modules/script.c), which already waits for a fresh key before
         * handing over whenever this entry's own text left something on
         * screen. */
        converse 5
    }
}
