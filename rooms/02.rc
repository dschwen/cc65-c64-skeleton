enter_room: default

# The two open doorways in the top wall transition the instant the player
# steps onto them: (2,0) behind the bar into the kitchen, (15,0) beside
# the hearth into the guest corridor.
enter_tile:
    at 2,0 -> script STORY_ROOM02_ENTER_KITCHEN
    at 15,0 -> script STORY_ROOM02_ENTER_CORRIDOR
    default -> none

look_at:
    at 17,9 -> script STORY_ROOM02_LOOK_ORRA
    at 3,2 -> script STORY_ROOM02_LOOK_VEY
    at 14,1 -> script STORY_ROOM02_LOOK_CALDUS
    at 2,3 -> script STORY_ROOM02_LOOK_BELL
    at 15,4 -> script STORY_ROOM02_LOOK_TABLE
    default -> GAME_LOOK_DEFAULT

use_at:
    at 8,10 -> script STORY_ROOM02_LEAVE_INN
    at 2,3 -> script STORY_ROOM02_RING_BELL
    # Sir Caldus, the hearth, Lady Orra and the dining table each check
    # inventory inside their script entry (check_item etc.).
    at 14,1 -> script STORY_ROOM02_TALK_CALDUS
    at 12,1 -> script STORY_ROOM02_USE_HEARTH
    at 17,9 -> script STORY_ROOM02_TALK_ORRA
    at 15,4 -> script STORY_ROOM02_USE_TABLE
    # Vey's own tile (3,2) is behind the bar counter and unreachable by the
    # player; (3,3), the counter tile directly in front of him, is the
    # closest point the Use cursor can reach from a walkable tile.
    at 3,3 -> script STORY_ROOM02_TALK_VEY
    default -> GAME_USE_DEFAULT
