enter_room: default
enter_tile: default

look_at:
    at 17,9 -> script STORY_ROOM02_LOOK_ORRA
    at 3,2 -> script STORY_ROOM02_LOOK_VEY
    at 13,1 -> script STORY_ROOM02_LOOK_CALDUS
    default -> GAME_LOOK_DEFAULT

use_at:
    at 8,10 -> script STORY_ROOM02_LEAVE_INN
    at 17,9 -> script STORY_ROOM02_TALK_ORRA
    # Sir Caldus (13,1) and the hearth (12,1) are handled in the asm
    # fallback below instead of a plain script entry here - both need an
    # inventory check (Lamp Oil / Long Taper) that the script DSL can't
    # express. See rooms/asm/02_use_at.s.
    # Vey's own tile (3,2) is behind the bar counter and unreachable by the
    # player (confirmed live: a flood-fill from the room's entrance shows
    # his whole alcove sealed off) - (3,3), the counter tile directly in
    # front of him, is the closest point the Use cursor can reach from a
    # walkable standing tile, even though the counter tile itself isn't
    # walkable ground (cursor movement only checks the player-relative
    # clamp, not tile walkability).
    at 3,3 -> script STORY_ROOM02_TALK_VEY
    at 19,6 -> script STORY_ROOM02_ENTER_KITCHEN
    default -> asm "rooms/asm/02_use_at.s"
