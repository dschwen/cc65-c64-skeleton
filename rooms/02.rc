enter_room: default
enter_tile: asm "rooms/c/02_enter_tile.c"

look_at:
    at 17,9 -> script STORY_ROOM02_LOOK_ORRA
    at 3,2 -> script STORY_ROOM02_LOOK_VEY
    at 14,1 -> script STORY_ROOM02_LOOK_CALDUS
    at 2,3 -> script STORY_ROOM02_LOOK_BELL
    at 15,4 -> script STORY_ROOM02_LOOK_TABLE
    default -> GAME_LOOK_DEFAULT

use_at:
    at 8,10 -> script STORY_ROOM02_LEAVE_INN
    # The service bell (2,3) is a plain state-flag check (HOST_REVEALED/
    # BROTH_SERVED/FINALE_DONE), which the script DSL can express on its
    # own via nested check_flag - see STORY_ROOM02_RING_BELL.
    at 2,3 -> script STORY_ROOM02_RING_BELL
    # Sir Caldus (14,1), the hearth (12,1), Lady Orra (17,9), and the
    # dining table (15,4) are all handled in the asm fallback below
    # instead of a plain script entry here - each needs an inventory
    # check (Lamp Oil / Long Taper / Orra Invite / Guest's Broth) that
    # the script DSL can't express. See rooms/c/02_use_at.c.
    # Vey's own tile (3,2) is behind the bar counter and unreachable by the
    # player (confirmed live: a flood-fill from the room's entrance shows
    # his whole alcove sealed off) - (3,3), the counter tile directly in
    # front of him, is the closest point the Use cursor can reach from a
    # walkable standing tile, even though the counter tile itself isn't
    # walkable ground (cursor movement only checks the player-relative
    # clamp, not tile walkability).
    at 3,3 -> script STORY_ROOM02_TALK_VEY
    default -> asm "rooms/c/02_use_at.c"
