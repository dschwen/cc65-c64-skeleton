enter_room: default
enter_tile: asm "rooms/c/03_enter_tile.c"

look_at:
    at 10,6 -> script STORY_ROOM03_LOOK_CAULDRON
    at 5,1 -> script STORY_ROOM03_LOOK_OIL
    at 14,1 -> script STORY_ROOM03_LOOK_TAPER
    at 10,1 -> script STORY_ROOM03_LOOK_STAIRS_DOWN
    at 11,6 -> script STORY_ROOM03_LOOK_KETTLE
    at 1,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 2,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 3,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 4,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 6,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 7,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 8,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 9,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 11,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 12,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 13,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 15,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 16,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 17,1 -> script STORY_ROOM03_LOOK_SHELVES
    at 18,1 -> script STORY_ROOM03_LOOK_SHELVES
    default -> asm "rooms/c/03_look_at.c"

use_at:
    # The kettle (11,6) needs a Blank Letter inventory check the script
    # DSL can't express - handled in the asm fallback. See
    # rooms/c/03_use_at.c.
    default -> asm "rooms/c/03_use_at.c"
