# Re-applies the two runtime changes the world-state journal does not
# cover (it tracks objects only, never tiles or the tile table): the
# repaired mirror's color and the unlocked alcove door.
enter_room: script STORY_ROOM04_ENTER_ROOM

# Stepping onto the stairs-up tile transitions back to the kitchen.
enter_tile:
    at 16,1 -> script STORY_ROOM04_ASCEND_STAIRS
    default -> none

look_at:
    at 16,1 -> script STORY_ROOM04_LOOK_STAIRS_UP
    at 12,1 -> script STORY_ROOM04_LOOK_MIRROR
    at 12,2 -> script STORY_ROOM04_LOOK_MIRROR
    at 13,1 -> script STORY_ROOM04_LOOK_MARA
    at 5,8 -> script STORY_ROOM04_LOOK_RECIPE_STONE
    at 17,2 -> script STORY_ROOM04_LOOK_WITCHLIGHT
    at 18,4 -> script STORY_ROOM04_LOOK_DOOR
    default -> GAME_LOOK_DEFAULT

use_at:
    at 18,4 -> script STORY_ROOM04_USE_DOOR
    at 12,1 -> script STORY_ROOM04_USE_MIRROR
    at 12,2 -> script STORY_ROOM04_USE_MIRROR
    at 13,1 -> script STORY_ROOM04_TALK_MARA
    # The two wall braziers (assets/04 places them at these tiles).
    at 11,3 -> script STORY_ROOM04_USE_BRAZIER
    at 13,3 -> script STORY_ROOM04_USE_BRAZIER
    default -> GAME_USE_DEFAULT
