enter_room: default

# The south-wall doorway (2,10) transitions back to the tavern on entry.
enter_tile:
    at 2,10 -> script STORY_ROOM05_LEAVE_CORRIDOR
    default -> none

look_at:
    at 4,7 -> script STORY_ROOM05_LOOK_PELL
    at 5,7 -> script STORY_ROOM05_LOOK_INVITATION
    at 4,3 -> script STORY_ROOM05_LOOK_BLUE_DOOR
    at 9,10 -> script STORY_ROOM05_LOOK_SILVER_DOOR
    at 17,10 -> script STORY_ROOM05_LOOK_ROSE_DOOR
    default -> asm "rooms/c/05_look_at.c"

use_at:
    at 4,3 -> script STORY_ROOM05_USE_GUEST_DOOR
    at 9,10 -> script STORY_ROOM05_USE_GUEST_DOOR
    at 17,10 -> script STORY_ROOM05_USE_GUEST_DOOR
    # Pell's Blue Seal hint is a check_item inside the entry.
    at 4,7 -> script STORY_ROOM05_TALK_PELL
    default -> GAME_USE_DEFAULT
